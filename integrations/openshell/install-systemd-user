#!/usr/bin/env bash
# install-systemd-user — install and enable the per-user upload cache and
# periodic Graft sync. Rerunnable.
set -euo pipefail

die() { printf 'install-systemd-user: %s\n' "$*" >&2; exit 1; }
log() { printf 'install-systemd-user: %s\n' "$*" >&2; }

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/../.." && pwd)"
STATE_ROOT="${GRAFT_AVM_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/graft/avm}"
STORE="${GRAFT_AVM_STORE:-$HOME/packages/avm-store}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
DRY_RUN=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --help|-h)
      cat <<'USAGE'
usage: install-systemd-user [--dry-run]

Environment:
  GRAFT_AVM_STATE  state root (default: $XDG_STATE_HOME/graft/avm)
  GRAFT_AVM_STORE  host avm-pkg store (default: ~/packages/avm-store)
  GRAFT_WORKSPACE_BIN / AVM_PKG_BIN / AVM_UPLOAD_BIN  binary overrides
USAGE
      exit 0
      ;;
    *) die "unknown argument: $1" ;;
  esac
done

WORKSPACE_BIN="${GRAFT_WORKSPACE_BIN:-$REPO_ROOT/target/release/workspace}"
[[ -x "$WORKSPACE_BIN" ]] || WORKSPACE_BIN="$REPO_ROOT/target/debug/workspace"
UPLOADD="${AVM_UPLOAD_BIN:-$REPO_ROOT/target/release/avm-uploadd}"
[[ -x "$UPLOADD" ]] || UPLOADD="$REPO_ROOT/target/debug/avm-uploadd"
AVM_PKG_BIN="${AVM_PKG_BIN:-}"
if [[ -z "$AVM_PKG_BIN" ]]; then
  AVM_PKG_BIN="$(command -v avm-pkg || true)"
fi
if [[ -z "$AVM_PKG_BIN" && -x "$REPO_ROOT/../australVM/safestos/pkg/target/release/avm-pkg" ]]; then
  AVM_PKG_BIN="$REPO_ROOT/../australVM/safestos/pkg/target/release/avm-pkg"
fi

[[ -x "$WORKSPACE_BIN" ]] || die "workspace not built; cargo build -p graft-workspace --bin workspace"
[[ -x "$UPLOADD" ]] || die "avm-uploadd not built; cargo build -p avm-uploadd"
[[ -n "$AVM_PKG_BIN" && -x "$AVM_PKG_BIN" ]] || die "avm-pkg not found; set AVM_PKG_BIN"
[[ -d "$STORE/index" ]] || die "avm-pkg store not initialized: $STORE"

WORKSPACE_BIN="$(readlink -f "$WORKSPACE_BIN")"
UPLOADD="$(readlink -f "$UPLOADD")"
AVM_PKG_BIN="$(readlink -f "$AVM_PKG_BIN")"
REPO_ROOT="$(readlink -f "$REPO_ROOT")"
STORE="$(readlink -f "$STORE")"
mkdir -p "$STATE_ROOT" "$CONFIG_DIR"

if [[ "$DRY_RUN" != 1 ]]; then
  GRAFT_AVM_STATE="$STATE_ROOT" "$SCRIPT_DIR/graft-avm-init" >/dev/null
fi

render() {
  local source="$1" target="$2"
  sed \
    -e "s|@REPO@|$REPO_ROOT|g" \
    -e "s|@STATE@|$STATE_ROOT|g" \
    -e "s|@STORE@|$STORE|g" \
    -e "s|@WORKSPACE@|$WORKSPACE_BIN|g" \
    -e "s|@AVM_PKG@|$AVM_PKG_BIN|g" \
    -e "s|@UPLOADD@|$UPLOADD|g" \
    "$source" > "$target"
  log "rendered $target"
}

render "$SCRIPT_DIR/systemd/graft-avm-uploadd.service" "$CONFIG_DIR/graft-avm-uploadd.service"
render "$SCRIPT_DIR/systemd/graft-avm-sync.service" "$CONFIG_DIR/graft-avm-sync.service"
render "$SCRIPT_DIR/systemd/graft-avm-sync.timer" "$CONFIG_DIR/graft-avm-sync.timer"

if [[ "$DRY_RUN" == 1 ]]; then
  exit 0
fi

systemctl --user daemon-reload
systemctl --user enable --now graft-avm-uploadd.service
systemctl --user enable --now graft-avm-sync.timer
log "upload cache: http://127.0.0.1:18090/<token>"
log "sync timer: $(systemctl --user is-active graft-avm-sync.timer)"
